# ── ROS 2 build artifacts ────────────────────────────────────────────────────
build/
install/
log/

# ── Compiled objects & shared libraries ──────────────────────────────────────
*.o
*.so
*.so.*

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd

# ── Machine-learning / voice model binaries ──────────────────────────────────
