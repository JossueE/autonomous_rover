# ── ROS 2 build artifacts ────────────────────────────────────────────────────
build/
install/
log/

# ── Compiled objects & shared libraries ──────────────────────────────────────
*.o
*.so
*.so.*

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd

# ── Machine-learning / voice model binaries ──────────────────────────────────
# Large assets fetched by rover_bt/scripts/install_voice_assets.sh.
# Do NOT commit them — download on first setup instead.
*.onnx
*.mdl
*.fst
*.dubm
*.ie
*.mat
*.ort
rover_bt/voice_assets/*

# ── Editor / tooling ─────────────────────────────────────────────────────────
.vscode/
.codex
