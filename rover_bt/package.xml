<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rover_bt</name>
  <version>0.1.0</version>
  <description>Central behavior tree for the autonomous rover. Handles mode
  management, navigation supervision, sensor health monitoring, multi-input
  command arbitration, and system lifecycle. Built on BehaviorTree.CPP v4.</description>
  <maintainer email="team@octavo.dev">Octavo Robotics</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <!-- Core ROS2 -->
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>ament_index_cpp</depend>

  <!-- BehaviorTree.CPP v4 -->
  <depend>behaviortree_cpp</depend>

  <!-- ROS2 message types -->
  <depend>builtin_interfaces</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>

  <!-- TF2 -->
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>

  <!-- Message generation runtime -->
  <member_of_group>rosidl_interface_packages</member_of_group>
  <exec_depend>rosidl_default_runtime</exec_depend>

  <!-- PERSON_TRACK mode launches/controls the person_tracker follower. -->
  <exec_depend>person_tracker</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
